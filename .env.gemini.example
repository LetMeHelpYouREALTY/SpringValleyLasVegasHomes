# Next.js / Vercel — call the Cloudflare Gemini Worker (server-side only).
# The Gemini API key is NOT set here. Store it on the Worker:
#   wrangler secret put GEMINI_API_KEY
#   wrangler secret put GEMINI_WORKER_SECRET
#
# Copy the Worker secret into Vercel as GEMINI_WORKER_SECRET so this
# site can authenticate to /gemini/*.

GEMINI_WORKER_URL=https://springvalleylasvegashomes-worker.YOUR_ACCOUNT.workers.dev
GEMINI_WORKER_SECRET=
